{
  "name": "nexusops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:import-local": "node --import tsx scripts/import-local.ts",
    "test:auth": "node --import tsx scripts/auth-smoke.ts",
    "test:isolation": "node --import tsx scripts/isolation-smoke.ts",
    "test:workspaces": "node --import tsx scripts/workspace-smoke.ts",
    "test:planning": "node --import tsx scripts/planning-smoke.ts",
    "test:attachments": "node --import tsx scripts/attachments-smoke.ts",
    "test:notifications": "node --import tsx scripts/notifications-smoke.ts",
    "test:agents": "node --import tsx scripts/agents-smoke.ts",
    "test:developer": "node --import tsx scripts/developer-keys-smoke.ts"
  },
  "dependencies": {
    "@next/env": "^15.5.28",
    "@scalar/nextjs-api-reference": "^0.12.11",
    "@tailwindcss/postcss": "^4.1.13",
    "drizzle-orm": "^0.44.5",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.13",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
