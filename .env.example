# Local PostgreSQL connection.
DATABASE_URL=postgresql://postgres@localhost:5435/nexusops_taskmanager
# Required to enable external administrator API access.
NEXUS_ADMIN_TOKEN=
# External task workers use this token; falls back to the admin token when unset.
NEXUS_WORKER_TOKEN=
# Required for signed external ingest webhooks.
NEXUS_WEBHOOK_SECRET=
# Local file fallback only; this does not bypass login. PostgreSQL is required for accounts.
NEXUS_DEMO_MODE=false

# Optional S3-compatible object storage (MinIO) for avatars and attachments.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=nexusops

# Alter One OAuth2 Authorization Code flow.
ALTER_ONE_URL=https://one.alterindonesia.com
ALTER_ONE_CLIENT_ID=
ALTER_ONE_CLIENT_SECRET=
ALTER_ONE_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional workspace ID for signed webhook ingestion. Omit to use the isolated legacy workspace.
NEXUS_WEBHOOK_WORKSPACE_ID=
