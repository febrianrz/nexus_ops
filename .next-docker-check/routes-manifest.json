{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/v1/actors/[id]",
      "regex": "^/api/v1/actors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/actors/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/tasks/[id]",
      "regex": "^/api/v1/tasks/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/tasks/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/tasks/[id]/attachments",
      "regex": "^/api/v1/tasks/([^/]+?)/attachments(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/tasks/(?<nxtPid>[^/]+?)/attachments(?:/)?$"
    },
    {
      "page": "/api/v1/tasks/[id]/attachments/[attachmentId]",
      "regex": "^/api/v1/tasks/([^/]+?)/attachments/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPattachmentId": "nxtPattachmentId"
      },
      "namedRegex": "^/api/v1/tasks/(?<nxtPid>[^/]+?)/attachments/(?<nxtPattachmentId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/tasks/[id]/delegate",
      "regex": "^/api/v1/tasks/([^/]+?)/delegate(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/tasks/(?<nxtPid>[^/]+?)/delegate(?:/)?$"
    },
    {
      "page": "/api/v1/tasks/[id]/events",
      "regex": "^/api/v1/tasks/([^/]+?)/events(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/tasks/(?<nxtPid>[^/]+?)/events(?:/)?$"
    },
    {
      "page": "/api/v1/tasks/[id]/telemetry",
      "regex": "^/api/v1/tasks/([^/]+?)/telemetry(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/tasks/(?<nxtPid>[^/]+?)/telemetry(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/auth/callback",
      "regex": "^/auth/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/callback(?:/)?$"
    },
    {
      "page": "/developer/docs",
      "regex": "^/developer/docs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/developer/docs(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    },
    {
      "page": "/welcome",
      "regex": "^/welcome(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/welcome(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}